261009/main/audio/2c/2cd214a4f1a8c31a99818e86ac6ee8f307351c7bdb4d316712a29e3129f8039b.mp3"},{"voiceId":"345af882-486b-4bd1-b9c8-6d2ed88facac","displayName":"ai男声 · 沉稳","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["沉稳"],"gender":"male","referenceText":"现在，请你找一个舒服的姿势，让身体慢慢放松下来。可以先闭上眼睛，跟着自己的呼吸，轻轻地吸气，再缓缓地呼气。接下来的一小段时间，只需要专注在此刻，让自己稍微停一停。","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/2c/2cbb3453461f999112da37ec1bba4ceae6434d9279439a7ffe2f18e824350c82.mp3"},{"voiceId":"e3ccdf35-1942-495b-bbd0-5240c267335e","displayName":"me · 磁性","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["磁性"],"gender":"male","referenceText":"旅行者你好，欢迎来到这个世界，我将成为你在这个世界的向导，加油吧","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/66/6659c3da58025cee9243144c92577a124173824f071ae0b4f61337818004951f.mp3"},{"voiceId":"d95228f6-2d2d-46d6-9ba9-16600b2096c7","displayName":"不死鸟","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["游戏"],"gender":"male","referenceText":"哈喽大家好我是猎枭很高兴出席今天的无畏小剧场旁边的是今天的特邀嘉宾ko叔叔","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/cd/cd094b5d0648be1a8ba57478c0865149b49321c84e044daab00c5b8021cab727.mp3"},{"voiceId":"3f2e42d4-83df-4c9c-b2ea-b3b3fb5989e9","displayName":"乔兮 · 温柔","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["温柔"],"gender":"male","referenceText":"马克思主义新闻观专题培训班在拉萨开班，旨在深化“新闻援藏”工作的具体行动，通过“送课上门”的形式，将优质培训资源直达雪域高原基层一线。","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/a5/a5193c91774458279c92dd1c55d83fe6a3f0675410d7e8d0a0a03afcea046bf1.mp3"},{"voiceId":"5613547d-2b52-478b-9926-58e8906570aa","displayName":"低沉青年 · 沉稳","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["沉稳"],"gender":"male","referenceText":"我叫赵凌，盛城大学的学生    而她是我高中三年的白月光，林晚","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/50/50bc98355885c16fcfd36b64d9da2b60e3173dc33709bc7cfd3937ef8f78accf.mp3"},{"voiceId":"dc2f0712-5674-4337-81fb-996317b916ac","displayName":"像鼻涕虫一样粘人的小反派 · 搞笑","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["搞笑"],"gender":"male","referenceText":"“哼…你这狡猾的小子。“\n“能看懂我俩这笔烂账的…都是同道。”\n“选错阵营的…本座夜里托梦找你聊。”\n“听好了…我只说一次。”","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/0a/0afd3b880f7b8f21be800218701efbbb2293ac463580988749155b5439a2cccb.mp3"},{"voiceId":"204d05fc-2b06-41b7-b5cf-67c1a9441bf4","displayName":"儿童染发膏如果 · 温柔","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["温柔"],"gender":"male","referenceText":"吃拼好饭时在浴室洗澡的美女室友突然发出一声惨叫 。\n慌乱地从卫生间跑出来。\n一丝不挂。\n我当时有些懵。\n呆呆的被硬控在原地三秒。\n咱就说先不管漏哪儿了。\n要不你去把衣服穿上呢。\n我是做自媒体的。\n刚入行。\n收入将将够温饱。\n衣食住行这一块就得能省则省。\n于是找了一个特别便宜的房子住。\n老小区。\n六楼。\n没有电梯。\n屋里那造型怎么说呢。\n说它家徒四壁还有点埋汰它。\n说它破旧不堪确实带点表扬它的意思了。\n该有的东西确实有。\n不是不能用就是不好用。\n好在我一个男人。\n没那么多讲究。\n有个窝住着。\n遮风挡雨就可以。","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/eb/ebee22ae3cd3aef724278fca9904cc60ff75b897150949cac1e89d70b79f4913.mp3"},{"voiceId":"2d03111b-d6d6-495e-892d-ff4f77dd29ae","displayName":"国王","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["游戏"],"gender":"male","referenceText":"想用饥荒击败我?那你失算了\n华夏子孙怎么可能没有种地基因呢?\n接下来砍木材，造箭塔!\n挖石料，修城墙\n三日后你们不是来收尸的，而是来送死的!","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/97/974ae39b2f62eefe09013559b7b99cff0790c9b6e4707f4c62cd6ac67da8995c.mp3"},{"voiceId":"81baf54d-7b72-471f-9dcd-35938edb72b5","displayName":"大司马 · 霸总","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["霸总"],"gender":"male","referenceText":"兄弟们，这波团战关键在于站位，你看这个位置多么完美，我们要沉着冷静，等对面技能转好。记住啊，不要急，该出手时就出手，这就是最基本的意思。老司机带带你们。","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/a8/a8d15284e33c5d5336ba4c040134d0385b0295cd8dc2b3eaef82db0f2f1efdb7.mp3"},{"voiceId":"a37d3ab5-d1ea-4cba-b38b-e28e81013cc9","displayName":"总裁音01","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["游戏"],"gender":"male","referenceText":"我想要的，一定能得到。包括你，亲爱的。","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/88/88cd692086bb0f6a0f40f643180675eb668b5d8a345cce0a760f17edd715a210.mp3"},{"voiceId":"7b411d5e-343e-4616-a468-773e7c52c3f1","displayName":"我卢本伟真的没有开挂 · 磁性","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["磁性"],"gender":"male","referenceText":"不是吧兄弟？这球，都能进吗？门将吃屎去吧！","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/c1/c16e56cb7fe1ff02a205e900d8ac955e84ce11787f629960bd3d1d71e4f1897b.mp3"},{"voiceId":"f229aaa9-4653-4acd-b992-2c811f3e0605","displayName":"春风吞噬 · 搞笑","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["搞笑"],"gender":"male","referenceText":"星域之中，神秘的虚空巨兽现身，震撼着诸界生灵。罗峰立于浩瀚星空之下，感受着体内血脉的震颤。这一次的机缘造化或将改变整个宇宙格局，而他却不知是福是祸。","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/4d/4d42c82902430981d5dcca4a9eedd5e16195b6bbede1eca0bf5b87624b3379be.mp3"},{"voiceId":"a0ec847c-14d4-4482-bbc3-e2c57ce35c58","displayName":"朱一龙","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["游戏"],"gender":"male","referenceText":"巴山楚水凄凉地，航天不能太安静","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/5f/5f4dfde0676198334bbaf2142d8b48a2fd6f11e4c31534bab60bc3f1f26509fb.mp3"},{"voiceId":"275b1872-e910-48dd-8696-bd770e19a456","displayName":"楠哥哥 激动版 · 轻快","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["轻快"],"gender":"male","referenceText":"兄弟们，这款新游戏简直太震撼了，画面精美就不说了，最重要的是战斗系统太独特了，没有固定套路，完全靠实力说话。我玩的整整一天都停不下来，这游戏真的会上瘾啊，想玩的赶紧来试试吧，保证让你大吃一惊。","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/1f/1f0174754ec06e4f889c47781b8c7aa94bb2a852445c4ed51c269f74706b7b0b.mp3"},{"voiceId":"833fa9ce-b1f9-4336-b46e-ea7fd156ecfa","displayName":"王也-2","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["游戏"],"gender":"male","referenceText":"从道家讲，财的到来，它跟努力是没有关系！都是水到渠成的，都是气运推着你走的。包括你遇到的贵人，不是求来的，都是莫名其妙的出现。大财都是大风刮来的，时机一到，一切顺其自然，发家也就两三年，能赚到别人 一辈子的财富！大财在命里也叫偏财，小财靠勤，中财靠德，大财靠命，运到了不用去求，运没到求也求不来。\n评论区留一句「时来运转」，接住你下半年的大运。","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/1c/1c290cb6514d1e6aa1eee21130e8e212f7397b3c01ed1ca5f3fe93c4233fca20.mp3"},{"voiceId":"94ea697f-d96c-448d-9760-5dea6daa5747","displayName":"磁性男声 · 磁性","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["磁性"],"gender":"male","referenceText":"都病得人鸟不分了，我没事。这种话果然没有几分可信度。量一下体温，以为耍赖我就没办法了，这样也能量，还是疼，真可怜。告诉我怎么做能让你舒服。那边是蜂糖的香味。","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/a1/a1f2d8df6534a799900a72a42d19e2ba3f4b44cfcd7beba24798cfd208bd181a.mp3"},{"voiceId":"e031f307-4395-46c0-a76a-8f5005892e7f","displayName":"路程 · 沉稳","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["沉稳"],"gender":"male","referenceText":"昨天怎么样？今天怎么样？明天怎么样？我不在你身边的每一天，你过得怎么样？我很在乎。","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/9d/9d8707ade75dec93c1a8a935fb49295c546924b156509ed355cb96ea5d0232db.mp3"},{"voiceId":"4308572c-a884-4c28-9d0e-95c3fa5e7485","displayName":"青年 · 沉稳","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["沉稳"],"gender":"male","referenceText":"这一块不起眼的小小矿石，是无数先辈踏遍荒山野岭换来的家国底气，是当年冲破外部核讹诈封锁、正式开启我国原子能事业的破局之石，那群扎根深山默默付出的人，他们漫长又执着的坚守，永远不该被岁月掩埋、被世人遗忘。","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/1e/1e54414ce646d440e2c87fc24813236c62e368c9172642b0eba71d490dad972c.mp3"},{"voiceId":"42813e2a-a6e2-4fb2-aa3c-7600fdac3c2c","displayName":"骆云影… · 沉稳","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["沉稳"],"gender":"male","referenceText":"反复的回忆，曾经的失误，痛苦，再以此为源头，折磨现在的自己，不去想着如何摆脱现状，却整天想着会有人能理解自己，同情自己吗？非常愚蠢的做法，把你的伤口扒开给别人看，只会让人知道你伤痕累累，更适合欺凌而已。我对任何人的过去都没有兴趣，但如果你需要我的帮助，那就直接开口向我索要。比起弯弯绕绕，直爽一点，会更让我欣赏。","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/3b/3bbe3c68e02e9b9cf31cc6a6f0d7aaa4122edb89c38a8efd5730a73a84ecb0ba.mp3"},{"voiceId":"41d0ca92-03c9-412f-8c57-66ee0bb93b98","displayName":"，123 · 温柔","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["温柔"],"gender":"male","referenceText":"今日天光清透，檐间桐叶簌簌作响，窗风携着院中草木与药草淡香漫入屋内。行医之人，本就该看淡俗世纷扰，医道在心，不在门第规矩。人体经脉流转如江河，淤堵则生痛，人心郁结亦是同理，不必事事强压心底。你若心中烦闷，不妨随我到后院药池坐坐，温水安神，药性舒缓，万事都可慢慢说与我听。","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/9f/9f66a449cb6c1613fe65bb6bf66f4aa5bf607467c44abd7c2de42b253adb1781.mp3"},{"voiceId":"8b927fb8-b179-42fc-82be-e16f97ce4a1e","displayName":"剑魔 · 赛博朋克","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["赛博朋克"],"gender":"male","referenceText":"凡人们，战争的号角已经吹响，你们的血肉将成为我重生的养料，你们的哀嚎将是我胜利的赞歌。","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/92/92952b736c7d3e8b4199d68f26388afa95963344dcf5787baa146110d41c1fe6.mp3"},{"voiceId":"4d1119ef-5919-456f-87b3-4cf9e0c1ec67","displayName":"孙笑川 · 自然","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["自然"],"gender":"male","referenceText":"兄弟们，今天又是躺平的一天，打了一天游戏，饿了就点个外卖，累了就睡觉。这日子过得是真舒服，就是房东又催房租了，烦死了，有没有？董哥来救救我啊。","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/f8/f825acf983463ab1c37ea48c44ee684451e0009fd86cce3eb4ce87d6fb70522e.mp3"},{"voiceId":"bdb0d47a-7b2a-40b0-8892-df334fb0774a","displayName":"海神","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["游戏"],"gender":"male","referenceText":"哈喽大家好我是猎枭很高兴出席今天的无畏小剧场旁边的是今天的特邀嘉宾ko叔叔","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/57/572d1344d4d451523db5fb3e8a4c11422f435c67e2e73104cae1d692e1e745f1.mp3"},{"voiceId":"fc79c3f8-f17d-454f-975f-99248502a791","displayName":"蛮王 · 明亮","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["明亮"],"gender":"male","referenceText":"弗雷尔卓德是个苦寒之地～一般人根本受不了这种煎熬的生活","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/df/df41e294354b462f8456d021c706bac70804760a0c363a617ea1b91879531b63.mp3"},{"voiceId":"366b015e-512f-4e70-ad8c-87557dbb6a2c","displayName":"贝尔格里尔斯 · 沉稳","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["沉稳"],"gender":"male","referenceText":"我正进入墨西哥的铜峡谷，它位于美国边境以南四百八十公里，几百条蜿蜒深邃的峡谷。","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/dc/dc174fd5794553cf0457c1b584bd2dff58ba7dba1f5a9d565ae809afa5a028f4.mp3"},{"voiceId":"72ecba63-40dd-4262-b376-6753b691c7da","displayName":"邪恶魔法师 · 反派感","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["反派感"],"gender":"male","referenceText":"欢迎来到我的激光挑战，躲避激光到我面前，赢了给奖励，输了去死","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/80/80f0508dd1ad39d747c5b44499b9d9e797ec6141b89e920c63d1ed7df480c6b2.mp3"},{"voiceId":"bbed1ab8-f3cd-4739-a92b-818ada55b2b2","displayName":"小明游戏主播 · 自然","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["自然"],"gender":"male","referenceText":"你们知道为什么我讨厌这些所谓的数据分析吗？啊，打个比方啊，你玩辅助一场游戏下来付出那么多，结果就因为数据不好被喷。懂不懂？什么叫团队游戏啊，真的是服了，这些人脑子里面装的都是什么啊？","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/18/18e54681b4895e38229baf326958a458eebf1c343f6de82d15c4848c493017a9.mp3"},{"voiceId":"4f574281-090f-4aa5-b0d3-5eda1f6c88e5","displayName":"游戏主播激动版 · 搞笑","locale":"游戏","category":"游戏","matchedScenes":["游戏"],"styleLabels":["搞笑"],"gender":"male","referenceText":"为什么你修炼千年还是这么弱呢？你看到人家随便一个小妖都能把你打趴下，好不好？你天天喊着要成仙，结果连个仙气都感应不到，找找自己问题好不好？为什么别人能得到飞升，你却还在这里当凡人呢？","audio_url":"https://raw.githubusercontent.com/jwoo1982217-eng/moting-voice-materials-20261009/main/audio/6c/6cf36c5b2e452003ba62a196d3b3c7ccfee5195de8abccf4a11328b0072bdc9d.mp3"}]
